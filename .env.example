# ==========================================================================
# Waterford Walk In Clinic — environment configuration
# --------------------------------------------------------------------------
# LOCAL DEV (this file as-is): SQLite + file sessions — zero setup.
#
# PRODUCTION (Cloudflare Container, current target): secrets are set via
#   `wrangler secret put <NAME>` (APP_KEY, DB_PASSWORD, MAIL_PASSWORD), never
#   committed here. Non-secret production values live in wrangler.jsonc's
#   `vars`, or get baked in at container start — see docker-entrypoint.sh
#   and the migration plan for the full list and why config:cache runs at
#   container START rather than build time. See scripts/verify-deploy.sh to
#   confirm a deploy actually behaves correctly end to end, not just that it
#   boots.
#
# LARAVEL CLOUD (previous host, kept warm as rollback fallback for a few
#   weeks post-cutover per the migration plan): Cloud injects DB_*, APP_KEY,
#   APP_URL via its own Environment tab.
#
# Copy this file to `.env` for local dev, then adjust only what you need.
# ==========================================================================

APP_NAME="Waterford Walk In Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Dublin
APP_URL=http://localhost:8000

# Frontend origin (dev only — Vite dev server). In production the SPA and
# API share one origin, so SANCTUM_STATEFUL_DOMAINS = your APP_URL host.
#
# PRODUCTION: APP_URL=https://cf-staging.waterfordclinic.ie during the
# staging phase, then https://waterfordclinic.ie at cutover; matching
# SANCTUM_STATEFUL_DOMAINS each time (host only, no scheme).
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# LOCAL DEV: SQLite file ships pre-built at database/database.sqlite,
# so zero config needed.
#
# PRODUCTION (Cloudflare Container): Cloudflare D1, reached over its REST
# API (ntanduy/cloudflare-d1-database package) - NOT a normal PDO/TCP
# connection, and NOT reachable via a `d1_databases` Worker binding or
# Hyperdrive, since this app runs as a PHP process in a Container, not
# inside a Worker's own JS runtime. Set:
#     DB_CONNECTION=d1
#     CF_D1_DATABASE_ID=<from `wrangler d1 create waterfordclinic`>
#     CF_D1_ACCOUNT_ID=<your Cloudflare account id>
#     CF_D1_API_TOKEN=      # set via `wrangler secret put CF_D1_API_TOKEN`, never here
#
# transaction_mode is forced to 'exception' in config/database.php's d1
# block, not the package's default 'silent' - D1 has no interactive
# transaction support over HTTP (only an atomic batch() primitive needing
# every statement prepared upfront), so any future code that assumes
# DB::transaction() gives real atomicity must fail loudly at the point of
# use, not silently lose it. There are currently zero DB::transaction()
# calls in this app, so this doesn't change today's behavior - it's a
# guardrail for whoever adds the first one.
#
# The d1 connection's circuit_breaker.cache_driver is pinned to 'file', not
# 'database' - detecting "is D1 down" by querying D1 would be circular.
#
# Migrating existing data from sqlite to D1: see
# `php artisan db:sync-sqlite-to-d1` (app/Console/Commands) - copies every
# table in FK-dependency order and verifies row counts match before
# declaring success.
#
# LARAVEL CLOUD (previous host): used its own managed MySQL via an
# injected DB_URL - kept here only as historical context during the
# rollback window, not the active target.

DB_CONNECTION=sqlite
DB_DATABASE=database.sqlite
# Cloudflare D1 (Cloudflare Container production target):
# DB_CONNECTION=d1
# CF_D1_DATABASE_ID=
# CF_D1_ACCOUNT_ID=
# CF_D1_API_TOKEN=

# --------------------------------------------------------------------------
# Sessions / Cache / Queue
# --------------------------------------------------------------------------
# LOCAL DEV: file-backed (no extra setup).
# PRODUCTION (Cloudflare Container, and previously Laravel Cloud): use
# database — a container process is single-instance here (no horizontal
# scaling need for this app's traffic), but file/in-process stores are still
# wrong: container disk is ephemeral and wiped on every sleep/restart, so a
# file-backed session would silently log everyone out on every cold start.
# The cache + jobs + sessions tables are created by migrations
# 000003 / 000011 / 000012.
#
# NEVER set SESSION_DRIVER=cookie. Laravel's CookieSessionHandler names its
# cookie after the current session ID itself (not a fixed name), stuffs the
# entire session payload into it on top of the normal session cookie, and
# mints a brand-new one on every request that doesn't round-trip cookies
# correctly. From the outside this looks exactly like "a new ~700-900 byte
# cookie with a random name on every request" — confirmed live on
# waterfordclinic.ie in Aug 2026, traced back to this driver being set
# instead of `database` in the previous host's dashboard. There is no
# dashboard on the Cloudflare Container setup to drift out of sync in the
# same way — this value is set here, in git — but the rule still applies if
# anyone is ever tempted to "simplify" it later.
#
# CACHE_STORE=database also requires a matching entry in config/cache.php's
# `stores` array (added when this migration landed - was previously missing
# entirely, which would have hard-crashed the app the moment this was set).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Production overrides (Cloudflare Container - set these via `wrangler
# secret put` / wrangler.jsonc `vars`, not by editing this file):
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=sync
# SESSION_SECURE_COOKIE=true
# LOG_CHANNEL=stderr

# --------------------------------------------------------------------------
# Email (clinic notifications + patient confirmation emails)
# --------------------------------------------------------------------------
# LOCAL DEV: keep MAIL_MAILER=log — emails are written to storage/logs/laravel.log
#   instead of being sent (so dev never accidentally emails real patients).
#
# PRODUCTION: set MAIL_MAILER=smtp + the waterfordclinic.ie SMTP settings
#   below. This is the clinic's own mail server - fully portable, not tied
#   to any hosting platform, no change needed from what already worked on
#   Laravel Cloud. IMPORTANT — set the real MAIL_PASSWORD via
#   `wrangler secret put MAIL_PASSWORD`, NOT in this file (this file is
#   committed to git).
#
#   Port 465 = implicit SSL → MAIL_ENCRYPTION=ssl (NOT tls).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@waterfordclinic.ie"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP (waterfordclinic.ie) — uncomment and set MAIL_PASSWORD via
# `wrangler secret put MAIL_PASSWORD`:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.waterfordclinic.ie
# MAIL_PORT=465
# MAIL_USERNAME=info@waterfordclinic.ie
# MAIL_PASSWORD=          # ← set via `wrangler secret put MAIL_PASSWORD`, never commit it
# MAIL_ENCRYPTION=ssl

# --------------------------------------------------------------------------
# Admin demo credentials (seeded by AdminUserSeeder / build_db.py)
# --------------------------------------------------------------------------
# Username: admin   Password: ChangeMe123!
# ⚠️  CHANGE THIS PASSWORD in the admin dashboard before going live.
