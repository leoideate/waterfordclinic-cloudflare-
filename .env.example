# ==========================================================================
# Waterford Walk In Clinic — environment configuration
# --------------------------------------------------------------------------
# LOCAL DEV (this file as-is): SQLite + file sessions — zero setup.
# LARAVEL CLOUD (production): see DEPLOYMENT.md — Cloud injects DB_*, APP_KEY,
#   APP_URL, and you set SESSION_DOMAIN / SANCTUM_STATEFUL_DOMAINS / MAIL_*.
# Copy this file to `.env`, then adjust only the lines you need to change.
# ==========================================================================

APP_NAME="Waterford Walk In Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Dublin
APP_URL=http://localhost:8000

# Frontend origin (dev only — Vite dev server). In production the SPA and
# API share one origin, so SANCTUM_STATEFUL_DOMAINS = your APP_URL host.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# LOCAL DEV: SQLite file ships pre-built at database/database.sqlite,
# so zero config needed.
#
# LARAVEL CLOUD: Cloud injects a DB_URL (and individual DB_* vars) for the
# managed MySQL instance it provisions. To use it, set:
#     DB_CONNECTION=mysql
#     DB_URL=mysql://...injected-by-cloud...
# (Laravel reads DB_URL and overrides the discrete host/port/db/user/pass.)

DB_CONNECTION=sqlite
DB_DATABASE=database.sqlite
# MySQL alternative (also used on Cloud):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=walk_in_gp
# DB_USERNAME=root
# DB_PASSWORD=

# --------------------------------------------------------------------------
# Sessions / Cache / Queue
# --------------------------------------------------------------------------
# LOCAL DEV: file-backed (no extra setup).
# PRODUCTION (Cloud): use database — Cloud runs multiple instances, so any
# in-process / file store would desync. The cache + jobs + sessions tables
# are created by migrations 000003 / 000011 / 000012.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Production overrides (uncomment on Cloud):
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=database
# SESSION_SECURE_COOKIE=true

# --------------------------------------------------------------------------
# Email (clinic notifications + patient confirmation emails)
# --------------------------------------------------------------------------
# LOCAL DEV: keep MAIL_MAILER=log — emails are written to storage/logs/laravel.log
#   instead of being sent (so dev never accidentally emails real patients).
#
# PRODUCTION (Laravel Cloud): set MAIL_MAILER=smtp + the waterfordclinic.ie SMTP
#   settings below. IMPORTANT — set the real MAIL_PASSWORD in Cloud's
#   Environment tab, NOT in this file (this file is committed to git).
#
#   Port 465 = implicit SSL → MAIL_ENCRYPTION=ssl (NOT tls).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@waterfordclinic.ie"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP (waterfordclinic.ie) — uncomment and set MAIL_PASSWORD in Cloud env:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.waterfordclinic.ie
# MAIL_PORT=465
# MAIL_USERNAME=info@waterfordclinic.ie
# MAIL_PASSWORD=          # ← set the real password in Cloud Environment, never commit it
# MAIL_ENCRYPTION=ssl

# --------------------------------------------------------------------------
# Admin demo credentials (seeded by AdminUserSeeder / build_db.py)
# --------------------------------------------------------------------------
# Username: admin   Password: ChangeMe123!
# ⚠️  CHANGE THIS PASSWORD in the admin dashboard before going live.
